{
  "name": "yoto-local",
  "version": "1.0.0",
  "private": true,
  "description": "Download YouTube playlists locally and sync them to Yoto MYO cards",
  "author": "Stephen Cox",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "shared",
    "companion",
    "web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n companion,web -c green,cyan \"npm run dev -w companion\" \"npm run dev -w web\"",
    "dev:web": "npm run dev -w web",
    "dev:companion": "npm run dev -w companion",
    "build": "npm run build -w companion && npm run build -w web",
    "start": "npm run build -w companion && npm run start -w companion",
    "test": "npm run test -w companion",
    "lint": "eslint --cache .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0"
  }
}
